#!/bin/sh
# Stop the running daemons so the payload can replace their binaries. We deliberately do NOT
# kextunload a running gesture kext: a kext driving the live MT2 can't be hot-unloaded (its terminal
# holds a synthetic IOHIDDevice the HID stack retains, so kextunload does a PARTIAL teardown -- kills
# the reader, trackpad goes dead -- then fails, and a same-id new kext can't load over the stuck image
# => dead until reboot). Instead the running kext keeps driving; the new one stages and loads cleanly
# at the next boot (see postinstall + test_install_kext_load.sh). Standard macOS kext-update model.
launchctl unload /Library/LaunchDaemons/dev.modernmavericks.voodooinputmavericks.plist 2>/dev/null || true
launchctl unload /Library/LaunchDaemons/dev.modernmavericks.voodooinputmavericks.linkstated.plist 2>/dev/null || true
exit 0
